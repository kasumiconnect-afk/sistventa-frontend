{
  "ConnectionStrings": {
    "DefaultConnection": "${MYSQL_CONNECTION_STRING}"
  },
  "Jwt": {
    "Key": "${JWT_SECRET_KEY}",
    "Issuer": "SistVentaAPI",
    "Audience": "SistVentaClient",
    "ExpiryMinutes": "60"
  },
  "FrontendUrl": "${FRONTEND_URL}",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}